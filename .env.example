# MySQL connection
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
# (boleh kosong untuk local XAMPP/WAMP; tapi variabel harus ada)
MYSQL_DATABASE=

# Auth (JWT cookie)
# Generate a long random string for production
AUTH_SECRET=change_me_to_a_long_random_secret

# Optional (default 7d)
AUTH_TTL=7d

# Optional
MYSQL_CONN_LIMIT=10
